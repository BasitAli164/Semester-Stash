# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-super-secret-key-here-change-in-production

# Database Configuration
DATABASE_URI=sqlite:///instance/attendance_system.db

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ACCESS_TOKEN_EXPIRES=3600  # 1 hour

# File Storage Paths
TRAINING_IMAGES_PATH=./storage/training_images
PROCESSED_FACES_PATH=./storage/processed_faces
MODELS_STORAGE_PATH=./storage/models

# DeepFace Configuration
DEEPFACE_MODEL=ArcFace
DEEPFACE_DETECTOR_BACKEND=opencv
DEEPFACE_DISTANCE_METRIC=cosine
RECOGNITION_THRESHOLD=0.4

# Application Settings
MAX_IMAGE_SIZE=5  # MB
ALLOWED_EXTENSIONS=png,jpg,jpeg